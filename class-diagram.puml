@startuml

enum ClientState {
    MainUserSelect
    GeneralSelect
    FriendSelect
    Stopped
}

class Client {
    - _mainUser: User
    - _currentSong: Song
    - _player: SoundPlayer
    - _queue: Queue<Song>
    - _state: ClientState
    
    + Start()
    
    ' commands
    - AppendQueue(song: Song): void
    - PlaySong(): void
    - SkipSong(): void
    - TogglePause(): void
    - StopPlayer(): void
    
    ' state
    - MainUserSelect(): void
    - GeneralSelect(): void
    - FriendSelect():  void
    
    ' menus
    - SongSelectMenu(): Song
    - UserSelectMenu(): User
    - PlaylistSelectMenu(user: User): Playlist
    
    ' helpers
    - ClearTerminal(): void
    - Input(allowedChar: char[1..*]): char
}

class Song {
    - _title: string
    + Title: _title
    - _artist: Artist
    - _duration: double
    + Duration: _duration
    - _genre: string
    - _releaseDate: string
}

class User {
    - _name: string
    + Name: _name
    - _playlist: Playlist
}

class Playlist {
    - _title: string
    + Title: _title
    - _songAmount: int
    - _duration: double
    + Duration: _duration
    - _releaseDate: string
}

class Album {
    - _artist: Artist
    - _title: string
    + Title: _title
    - _songAmount: int
    - _duration: double
    + Duration: _duration
    - _genre: string
    - _releaseDate: string
} 

class Artist {
    - _name: string
    + Name: _name
    - _albums: Album
    - _songs: Song
}

@enduml