@startuml

enum ClientState {
    MainUserSelect
    GeneralSelect
    FriendSelect
    Stopped
}

class Client {
    - _mainUser: User
    - _currentSong: Song
    - _player: SoundPlayer
    - _queue: Queue<Song>
    - _state: ClientState
    
    + Start()
    
    ' commands
    - AppendQueue(song: Song): void
    - PlaySong(): void
    - SkipSong(): void
    - TogglePause(): void
    - StopPlayer(): void
    
    ' state
    - MainUserSelect(): void
    - GeneralSelect(): void
    - FriendSelect():  void
    
    ' menus
    - SongSelectMenu(): Song
    - UserSelectMenu(): User
    - PlaylistSelectMenu(user: User): Playlist
    
    ' helpers
    - ClearTerminal(): void
    - Input(allowedChar: char[1..*]): char
}

class Song {
    - _title: string
    + Title: _title
    - _artist: List (Artist)
    - _duration: double
    + Duration: _duration
    - _genre: List (String)
    - _releaseDate: string
}

class User {
    - _name: string
    + Name: _name
    - _friends: List (User)
    + Friends: _friends
    - _playlist: List (Playlist)
}

class Playlist {
    + Shuffle()
    + Play()
    + Stop()
    + Add(Song)
    + Remove(Song)
    + Rename(newName)
}

class SongCollection {
    - _title: string
    - _songAmount: int
    - _songList: List (Song)
    - _duration: double
    - _releaseDate: string
}

class Album {
    - _artist: List (Artist)
    - _genre: List (String)
}

class Artist {
    - _name: string
    + Name: _name
    - _albums: List (Album)
    - _songs: List (Song)
}
Artist "*" -- "*" Album
Artist "*" -- "*" Song
SongCollection <|-- Album
SongCollection <|-- Playlist
Album "1" o-- "*" Song
Playlist "*" o-- "*" Song
User "1" o-- "*" Playlist
Client *-- ClientState
@enduml